# Copy this file to .env in the repo root (next to docker-compose.yml) and fill
# in the values. The API, `npm run seed` and docker compose all read it.
# Never commit .env.

# --- App --------------------------------------------------------------------
NODE_ENV=development
PORT=3001
# Comma-separated origins allowed to call the API from a browser (the web portals).
# Leave empty in development to allow any origin. These are also the only other
# sites allowed to send state-changing requests with the refresh cookie (CSRF).
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies (nginx) in front of the API, so rate limits see the
# real client IP. 0 when the API is reached directly, as in development.
TRUST_PROXY=0
# Language used when a request sends neither x-lang nor Accept-Language: en or ckb.
DEFAULT_LANGUAGE=en

# --- Database ---------------------------------------------------------------
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
# docker compose creates the database with DB_PASSWORD as its root password.
DB_USERNAME=root
DB_PASSWORD=change-me
DB_NAME=parkeasy
# Only for DB_DIALECT=sqlite (handy for quick local tests): a file path or :memory:
# DB_STORAGE=:memory:
# Hosted databases (e.g. Aiven) need TLS: set DB_SSL=true and paste the
# provider's CA certificate into DB_SSL_CA, on one line with \n for line breaks.
DB_SSL=false
DB_SSL_CA=
# The API brings the database up to date (runs pending migrations) when it
# starts. Set to false to run them yourself with `npm run migrate` instead.
DB_MIGRATE_ON_START=true

# --- Tokens -----------------------------------------------------------------
# Three DIFFERENT long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_PASSWORD_SECRET=
# Lifetimes in SECONDS: 900 = 15 minutes, 604800 = 7 days.
JWT_ACCESS_EXPIRATION_TIME=900
JWT_REFRESH_EXPIRATION_TIME=604800

# --- Passwords --------------------------------------------------------------
# Server-side secret mixed into every password hash. Required in production.
# Changing it later makes every existing password stop working.
PEPPER_SECRET=
SALT_ROUNDS=10
# Every rule is ON unless set to false.
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# --- Email (password reset codes) -------------------------------------------
# Leave MAIL_USER / MAIL_PASSWORD empty in development: the code is then printed
# in the server log instead of being emailed. For Gmail, use an App Password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM='"ParkEasy" <no-reply@parkeasy.app>'

# --- Payments (wallet top-ups) ----------------------------------------------
# "mock" is a built-in stand-in for FIB (First Iraqi Bank): top-ups are approved
# from the app's test screen, no bank account needed. Its payments live in
# memory, so a restart expires the pending ones. Must be set in production.
PAYMENT_PROVIDER=mock
# Signs the provider's status callbacks. Empty = a dev-only secret; required in production.
PAYMENT_WEBHOOK_SECRET=
# Minutes the customer has to approve a payment before it expires.
PAYMENT_VALIDITY_MINUTES=15
