# Copy to .env.local to override locally (.env.local is git-ignored).
# Everything that starts with VITE_ is built into the public JavaScript bundle,
# so never put a secret here.

# Where the browser sends API calls. Keep /api: the dev server (and nginx in
# production) forwards it to the backend, so the portal and the API share one
# origin and the refresh cookie stays first-party.
VITE_API_URL=/api

# Shown in the browser tab after the page title.
VITE_APP_NAME=ParkEasy

# Dev server only (not built into the bundle): where `npm run dev` forwards /api.
DEV_API_TARGET=http://localhost:3001
